@using Karion.BusinessSolution.Authorization
@using Karion.BusinessSolution.Web.Areas.App.Models.LeaveRequests
@using Karion.BusinessSolution.Web.Areas.App.Startup
@model LeaveRequestsViewModel
@{
    ViewBag.CurrentPageName = AppPageNames.Common.LeaveRequests;
}
@section Scripts
{
    <script abp-src="/view-resources/Areas/App/Views/LeaveRequests/Index.js" asp-append-version="true"></script>
}
<div class="kt-content  kt-grid__item kt-grid__item--fluid kt-grid kt-grid--hor">


                <div class="kt-subheader kt-grid__item">
                  <div class="@(await GetContainerClass())">
                    <div class="kt-subheader__main">
                        <h3 class="kt-subheader__title">
                            <span>@L("LeaveRequests")</span>
                        </h3>
                        <span class="kt-subheader__separator kt-subheader__separator--v"></span>
                        <span class="kt-subheader__desc">
                            @L("LeaveRequestsHeaderInfo")
                        </span>
                    </div>
                    <div class="kt-subheader__toolbar">
                        <div class="kt-subheader__wrapper">
                            <button id="ExportToExcelButton" class="btn btn-outline-success"><i class="fa fa-file-excel"></i> @L("ExportToExcel")</button>
            @if (IsGranted(AppPermissions.Pages_LeaveRequests_Create))
                            {
                                <button id="CreateNewLeaveRequestButton" class="btn btn-primary blue"><i class="fa fa-plus"></i> @L("CreateNewLeaveRequest")</button>                
                            }
                        </div>
                    </div>
                  </div>
                </div>
            
<div class="@(await GetContainerClass()) kt-grid__item kt-grid__item--fluid">   
    <div class="kt-portlet kt-portlet--mobile">
        <div class="kt-portlet__body">
            <div class="kt-form">
                <div class="row align-items-center mb-4">
                    <div class="col-xl-12">
                        <div class="form-group align-items-center">
                            <div class="input-group">
                                <input type="text" id="LeaveRequestsTableFilter" class="form-control m-input" placeholder="@L("SearchWithThreeDot")" value="@Model.FilterText">
                                <span class="input-group-btn">
                                    <button id="GetLeaveRequestsButton" class="btn btn-primary" type="submit"><i class="flaticon-search-1"></i></button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
			</div>
                <div id="AdvacedAuditFiltersArea" style="display: none" class="row mb-4">
                    <div class="col-md-12">
						<div class="kt-separator kt-separator--border-dashed"></div>
					</div>

                            <div class="col-md-3">
                                    <div class="form-group">
										<label for="MinStartDateTimeFilterId">@L("StartDateTimeRange")</label>
										<div class="input-group">
											<input class="form-control m-input date-picker" type="text" placeholder="@L("MinValue")"  id="MinStartDateTimeFilterId">
											<span style="line-height: 40px;padding: 0 15px 0 15px;"> &mdash; </span>
											<input class="form-control m-input date-picker" type="text" placeholder="@L("MaxValue")"  id="MaxStartDateTimeFilterId">
										</div>
									</div>
                            </div>
                            <div class="col-md-3">
                                    <div class="form-group">
										<label for="MinEndDateTimeFilterId">@L("EndDateTimeRange")</label>
										<div class="input-group">
											<input class="form-control m-input date-picker" type="text" placeholder="@L("MinValue")"  id="MinEndDateTimeFilterId">
											<span style="line-height: 40px;padding: 0 15px 0 15px;"> &mdash; </span>
											<input class="form-control m-input date-picker" type="text" placeholder="@L("MaxValue")"  id="MaxEndDateTimeFilterId">
										</div>
									</div>
                            </div>
							<div class="col-md-3">
								<div class="form-group">
									<label for="LeaveTypeFilterId">@L("LeaveType")</label>
									<input type="text" class="form-control" name="leaveTypeFilter" id="LeaveTypeFilterId">
								</div>
                            </div>
							<div class="col-md-3">
								<label for="StatusFilterId">@L("Status")</label>
								<select class="form-control" name="StatusFilter" id="StatusFilterId">
								<option value="-1">@L("All")</option>
																			<option value="0">@L("Enum_LeaveRequestStatus_0")</option>

										<option value="1">@L("Enum_LeaveRequestStatus_1")</option>

										<option value="2">@L("Enum_LeaveRequestStatus_2")</option>


								</select>
                            </div>
							<div class="col-md-3">
								<div class="form-group">
									<label for="ReasonFilterId">@L("Reason")</label>
									<input type="text" class="form-control" name="reasonFilter" id="ReasonFilterId">
								</div>
                            </div>
							<div class="col-md-3">
								<label for="IsForEarlyLeaveFilterId">@L("IsForEarlyLeave")</label>
								<select class="form-control" name="IsForEarlyLeaveFilter" id="IsForEarlyLeaveFilterId">
									<option value="-1">@L("All")</option>
									<option value="0">@L("False")</option>
									<option value="1">@L("True")</option>
								</select>
                            </div>
							<div class="col-md-3">
								<label for="IsForLateArrivalFilterId">@L("IsForLateArrival")</label>
								<select class="form-control" name="IsForLateArrivalFilter" id="IsForLateArrivalFilterId">
									<option value="-1">@L("All")</option>
									<option value="0">@L("False")</option>
									<option value="1">@L("True")</option>
								</select>
                            </div>
							<div class="col-md-3">
								<div class="form-group">
									<label for="NguoiBenhUserNameFilterId">(@L("NguoiBenh")) @L("UserName")</label>
									<input type="text" class="form-control" name="nguoiBenhUserNameFilter" id="NguoiBenhUserNameFilterId">
								</div>
                            </div>
							<div class="col-md-3">
								<div class="form-group">
									<label for="UserNameFilterId">(@L("User")) @L("Name")</label>
									<input type="text" class="form-control" name="userNameFilter" id="UserNameFilterId">
								</div>
                            </div>
							<div class="col-md-3">
								<div class="form-group">
									<label for="ShiftNameFilterId">(@L("Shift")) @L("Name")</label>
									<input type="text" class="form-control" name="shiftNameFilter" id="ShiftNameFilterId">
								</div>
                            </div>
                </div>
                <div class="row mb-4">
                    <div class="col-xl-12">
                        <span id="ShowAdvancedFiltersSpan" class="text-muted clickable-item"><i class="fa fa-angle-down"></i> @L("ShowAdvancedFilters")</span>
                        <span id="HideAdvancedFiltersSpan" class="text-muted clickable-item" style="display: none"><i class="fa fa-angle-up"></i> @L("HideAdvancedFilters")</span>
                    </div>
                </div>
            <div class="row align-items-center">
                <table id="LeaveRequestsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                    <thead>
                        <tr>
                            <th>@L("Actions")</th>
								<th>@L("StartDateTime")</th>
								<th>@L("EndDateTime")</th>
								<th>@L("LeaveType")</th>
								<th>@L("Status")</th>
								<th>@L("Reason")</th>
								<th>@L("IsForEarlyLeave")</th>
								<th>@L("IsForLateArrival")</th>
								<th>@L("NguoiBenhUserName")</th>
								<th>@L("UserName")</th>
								<th>@L("ShiftName")</th>
                        </tr>
                    </thead>
                </table>
            </div>
        </div>
    </div>
  </div>
</div>