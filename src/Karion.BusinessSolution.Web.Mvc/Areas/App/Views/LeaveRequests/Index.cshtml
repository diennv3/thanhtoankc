@using Karion.BusinessSolution.Authorization
@using Karion.BusinessSolution.Web.Areas.App.Models.LeaveRequests
@using Karion.BusinessSolution.Web.Areas.App.Startup
@model LeaveRequestsViewModel
@{
    ViewBag.CurrentPageName = AppPageNames.Common.LeaveRequests;
}
@section Scripts
{
    <script abp-src="/view-resources/Areas/App/Views/LeaveRequests/Index.js" asp-append-version="true"></script>
}

<div class="kt-content kt-grid__item kt-grid__item--fluid kt-grid kt-grid--hor">
    <div class="kt-subheader kt-grid__item">
        <div class="@(await GetContainerClass())">
            <div class="kt-subheader__main">
                <h3 class="kt-subheader__title">
                    <span>Đơn xin nghỉ</span>
                </h3>
                <span class="kt-subheader__separator kt-subheader__separator--v"></span>
                <span class="kt-subheader__desc">
                    Quản lý đơn xin nghỉ phép, xin về sớm, đi muộn
                </span>
            </div>
            <div class="kt-subheader__toolbar">
                <div class="kt-subheader__wrapper">
                    <button id="ExportToExcelButton" class="btn btn-outline-success">
                        <i class="fa fa-file-excel"></i> Xuất Excel
                    </button>
                    @if (IsGranted(AppPermissions.Pages_LeaveRequests_Create))
                    {
                        <button id="CreateNewLeaveRequestButton" class="btn btn-primary">
                            <i class="fa fa-plus"></i> Tạo mới
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="@(await GetContainerClass()) kt-grid__item kt-grid__item--fluid">
        <div class="kt-portlet kt-portlet--mobile">
            <div class="kt-portlet__body">
                <div class="kt-form">
                    <div class="row align-items-center mb-4">
                        <div class="col-xl-12">
                            <div class="form-group align-items-center">
                                <div class="input-group">
                                    <input type="text" id="LeaveRequestsTableFilter" class="form-control m-input" 
                                           placeholder="Tìm kiếm..." value="@Model.FilterText">
                                    <span class="input-group-btn">
                                        <button id="GetLeaveRequestsButton" class="btn btn-primary" type="button">
                                            <i class="flaticon-search-1"></i> Tìm
                                        </button>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="AdvacedAuditFiltersArea" style="display: none" class="row mb-4">
                    <div class="col-md-12">
                        <div class="kt-separator kt-separator--border-dashed"></div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="MinStartDateTimeFilterId">Khoảng thời gian bắt đầu</label>
                            <div class="input-group">
                                <input class="form-control m-input date-picker" type="text" placeholder="Từ" id="MinStartDateTimeFilterId">
                                <span style="line-height: 40px;padding: 0 15px 0 15px;"> &mdash; </span>
                                <input class="form-control m-input date-picker" type="text" placeholder="Đến" id="MaxStartDateTimeFilterId">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="MinEndDateTimeFilterId">Khoảng thời gian kết thúc</label>
                            <div class="input-group">
                                <input class="form-control m-input date-picker" type="text" placeholder="Từ" id="MinEndDateTimeFilterId">
                                <span style="line-height: 40px;padding: 0 15px 0 15px;"> &mdash; </span>
                                <input class="form-control m-input date-picker" type="text" placeholder="Đến" id="MaxEndDateTimeFilterId">
                            </div>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="LeaveTypeFilterId">Loại đơn</label>
                            <select class="form-control" name="leaveTypeFilter" id="LeaveTypeFilterId">
                                <option value="">Tất cả</option>
                                <option value="0">Nghỉ phép</option>
                                <option value="1">Nghỉ ốm</option>
                                <option value="2">Việc riêng</option>
                                <!-- Thêm các loại khác nếu có -->
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="StatusFilterId">Trạng thái</label>
                            <select class="form-control" name="StatusFilter" id="StatusFilterId">
                                <option value="-1">Tất cả</option>
                                <option value="0">Đang chờ duyệt</option>
                                <option value="1">Đã duyệt</option>
                                <option value="2">Bị từ chối</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="ReasonFilterId">Lý do</label>
                            <input type="text" class="form-control" name="reasonFilter" id="ReasonFilterId" placeholder="Nhập lý do...">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="IsForEarlyLeaveFilterId">Cho về sớm</label>
                            <select class="form-control" name="IsForEarlyLeaveFilter" id="IsForEarlyLeaveFilterId">
                                <option value="-1">Tất cả</option>
                                <option value="0">Không</option>
                                <option value="1">Có</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="IsForLateArrivalFilterId">Cho đi muộn</label>
                            <select class="form-control" name="IsForLateArrivalFilter" id="IsForLateArrivalFilterId">
                                <option value="-1">Tất cả</option>
                                <option value="0">Không</option>
                                <option value="1">Có</option>
                            </select>
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="NguoiBenhUserNameFilterId">Người (tên đăng nhập)</label>
                            <input type="text" class="form-control" name="nguoiBenhUserNameFilter" id="NguoiBenhUserNameFilterId" placeholder="Tên đăng nhập...">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="UserNameFilterId">Người duyệt (Tên)</label>
                            <input type="text" class="form-control" name="userNameFilter" id="UserNameFilterId" placeholder="Tên người duyệt...">
                        </div>
                    </div>

                    <div class="col-md-3">
                        <div class="form-group">
                            <label for="ShiftNameFilterId">Ca làm (Tên)</label>
                            <input type="text" class="form-control" name="shiftNameFilter" id="ShiftNameFilterId" placeholder="Tên ca làm...">
                        </div>
                    </div>
                </div>

                <div class="row mb-4">
                    <div class="col-xl-12">
                        <span id="ShowAdvancedFiltersSpan" class="text-muted clickable-item">
                            <i class="fa fa-angle-down"></i> Hiện thêm bộ lọc
                        </span>
                        <span id="HideAdvancedFiltersSpan" class="text-muted clickable-item" style="display: none">
                            <i class="fa fa-angle-up"></i> Ẩn bộ lọc
                        </span>
                    </div>
                </div>

                <div class="row align-items-center">
                    <table id="LeaveRequestsTable" class="display table table-striped table-bordered table-hover dt-responsive nowrap">
                        <thead>
                            <tr>
                                <th width="120">Hành động</th>
                                <th>Ngày bắt đầu</th>
                                <th>Ngày kết thúc</th>
                                <th>Loại</th>
                                <th>Lý do</th>
                                <th>Cho về sớm</th>
                                <th>Cho đi muộn</th>
                                <th>Nhân viên</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>