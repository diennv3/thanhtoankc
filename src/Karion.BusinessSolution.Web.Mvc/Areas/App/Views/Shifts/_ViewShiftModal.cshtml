
@using Karion.BusinessSolution.Web.Areas.App.Models.Common.Modals
@using Karion.BusinessSolution.Web.Areas.App.Models.Shifts
@model ShiftViewModel

@await Html.PartialAsync("~/Areas/App/Views/Common/Modals/_ModalHeader.cshtml", new ModalHeaderViewModel(L("Details")))

<div class="modal-body">
    <div id="ShiftInformationsTab">
        
        <div class="row">
            <div class="col-6 mb-3">
                <h6>@L("Code") :</h6>
                @Model.Shift.Code
            </div>
            <div class="col-6 mb-3">
                <h6>@L("Name") :</h6>
                @Model.Shift.Name
            </div>
            <div class="col-6 mb-3">
                <h6>@L("StartTime") :</h6>
                @Model.Shift.StartTime
            </div>
            <div class="col-6 mb-3">
                <h6>@L("EndTime") :</h6>
                @Model.Shift.EndTime
            </div>
            <div class="col-6 mb-3">
                <h6>@L("WorkDaysMask") :</h6>
                @Model.Shift.WorkDaysMask
            </div>
            <div class="col-6 mb-3">
                <h6>@L("ToleranceMinutes") :</h6>
                @Model.Shift.ToleranceMinutes
            </div>
            <div class="col-6 mb-3">
                <h6>@L("IsActive") :</h6>
                @Model.Shift.IsActive
            </div>
            <div class="col-6 mb-3">
                <h6>@L("Description") :</h6>
                @Model.Shift.Description
            </div>


        </div>

    </div>
</div>

@await Html.PartialAsync("~/Areas/App/Views/Common/Modals/_ModalFooterWithClose.cshtml")

